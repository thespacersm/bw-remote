#!/usr/bin/env python3
"""bw-remote: genera rclone.conf e ssh config dagli item Bitwarden con i campi remote_*."""
from __future__ import annotations

import argparse
import datetime
import difflib
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field, replace
from urllib.parse import urlsplit

VERSION = "0.1.0"

# remote_type -> tipo rclone
TYPES = {"ssh": "sftp", "sftp": "sftp", "ftp": "ftp", "ftps": "ftp"}
DEFAULT_PORTS = {"sftp": 22, "ftp": 21}
URI_SCHEMES = {"", "ssh", "sftp", "ftp", "ftps"}

ITEM_LOGIN, ITEM_NOTE = 1, 2
FIELD_LINKED = 3
LINKED = {100: "username", 101: "password"}

HEADER = "# generato da bw-remote: non modificare a mano, viene sovrascritto"
# rclone riscrive rclone.conf (e perde i commenti) quando salva i valori che rileva da solo:
# le sezioni generate si riconoscono dalla description, che rclone conserva
DESC_RE = re.compile(r"^description\s*=\s*bw-remote\s+(\S+)\s+(\S+)")
LEGACY_META_RE = re.compile(r"^# bw: (\S+) (\S+)")
LEGACY_LINE_RE = re.compile(r"^# (BEGIN bw-remote|END bw-remote|generato da bw-remote|bw: )")
SECTION_RE = re.compile(r"^\[([^\]]+)\]\s*$")
# valori che rclone rileva al primo uso di un remote sftp e salva nel file
AUTO_KEYS = ("shell_type", "md5sum_command", "sha1sum_command")
DEFAULT_KEY = "~/.ssh/id_rsa"
SFTP_SERVER = "/usr/lib/openssh/sftp-server"
NAME_RE = re.compile(r"^[A-Za-z0-9_.+@-]+$")
OLD_RE = re.compile(r"\bOLD\b")

# a parita di remote_name, il tipo che in ogni file prende il nome senza suffisso
# "via" e l'accesso al sito passando dalla macchina (remote_via): principale in ssh config,
# mentre in rclone resta principale l'accesso diretto (i file restano dell'utente del sito)
PREFERRED = {"rclone": ["sftp", "ftps", "ftp", "ssh", "via"], "ssh": ["via", "ssh", "sftp"]}


class ItemError(Exception):
    pass


@dataclass
class Remote:
    item_id: str
    item_name: str
    revision: str
    kind: str
    tls: bool
    name: str
    host: str
    user: str
    port: int
    pwd: str = ""
    key: str = ""
    aliases: list = field(default_factory=list)
    ssh_aliases: list = field(default_factory=list)
    rclone_opts: dict = field(default_factory=dict)
    ssh_opts: dict = field(default_factory=dict)
    rtype: str = ""
    old: bool = False
    direct: bool = True
    via: str = ""
    via_id: str = ""
    path: str = ""
    sudo: str = ""

    @property
    def ssh_names(self):
        return [self.name] + self.ssh_aliases

    @property
    def meta(self):
        name = " ".join(self.item_name.split())
        return f"# bw: {self.item_id} {self.revision} {name}"


def warn(msg):
    print(f"! {msg}", file=sys.stderr)


def die(msg):
    print(f"errore: {msg}", file=sys.stderr)
    sys.exit(1)


# --- Bitwarden ---------------------------------------------------------------

def run_bw(args):
    res = subprocess.run(["bw"] + args, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"bw {' '.join(args)}: {res.stderr.strip() or res.stdout.strip()}")
    return res.stdout


def load_items(args):
    if args.input:
        with open(args.input) as fh:
            return json.load(fh)
    if not shutil.which("bw"):
        die("bw non trovato nel PATH")
    status = json.loads(run_bw(["status"])).get("status")
    if status != "unlocked":
        die(f'bw e {status}: esegui  export BW_SESSION="$(bw unlock --raw)"')
    if not args.no_sync:
        run_bw(["sync"])
    return json.loads(run_bw(["list", "items"]))


def item_fields(item):
    """Campi remote_* dell'item, nome -> lista di valori (i campi possono ripetersi)."""
    login = item.get("login") or {}
    out = {}
    for f in item.get("fields") or []:
        name = (f.get("name") or "").strip().lower()
        if not name.startswith("remote_"):
            continue
        value = f.get("value")
        if f.get("type") == FIELD_LINKED:
            value = login.get(LINKED.get(f.get("linkedId"), ""))
        if value is None or str(value).strip() == "":
            continue
        out.setdefault(name, []).append(str(value).strip())
    return out


def split_uri(uri):
    if "://" not in uri:
        uri = "//" + uri
    try:
        parts = urlsplit(uri)
        port = parts.port
    except ValueError:
        return "", "", ""
    return parts.scheme.lower(), parts.hostname or "", str(port or "")


def parse_opts(values, label):
    rclone, ssh = {}, {}
    for v in values:
        target, sep, rest = v.partition(":")
        key, eq, value = rest.partition("=")
        if not sep or not eq or target not in ("rclone", "ssh") or not key.strip():
            raise ItemError(f"{label}: remote_opt '{v}' non valido (atteso rclone:chiave=valore o ssh:Chiave=valore)")
        (rclone if target == "rclone" else ssh)[key.strip()] = value.strip()
    return rclone, ssh


def parse_remote(item):
    """Remote dall'item, None se l'item non ha remote_type. ItemError se e incompleto."""
    if item.get("type") not in (ITEM_LOGIN, ITEM_NOTE):
        return None
    f = item_fields(item)
    if "remote_type" not in f:
        return None

    label = f"\"{item.get('name')}\""

    def one(key):
        values = f.get(key) or [""]
        if len(values) > 1:
            raise ItemError(f"{label}: {key} ripetuto")
        return values[0]

    rtype = one("remote_type").lower()
    if rtype not in TYPES:
        raise ItemError(f"{label}: remote_type '{rtype}' non supportato ({', '.join(TYPES)})")
    kind = TYPES[rtype]

    login = item.get("login") or {}
    user = one("remote_user") or (login.get("username") or "")
    pwd = one("remote_pwd") or (login.get("password") or "")
    host = one("remote_host")
    port = one("remote_port")
    if not host:
        for u in login.get("uris") or []:
            scheme, h, p = split_uri(u.get("uri") or "")
            if h and scheme in URI_SCHEMES:
                host, port = h, port or p
                break

    name = one("remote_name")
    via = one("remote_via")
    path = one("remote_path")
    sudo = one("remote_via_sudo")
    for key, value in (("remote_path", path), ("remote_via_sudo", sudo)):
        if value and not via:
            raise ItemError(f"{label}: {key} vale solo insieme a remote_via")
    if sudo and not NAME_RE.match(sudo):
        raise ItemError(f"{label}: remote_via_sudo '{sudo}' non valido")
    # con remote_via l'accesso diretto e facoltativo: senza host e utente c'e solo quello via macchina
    required = [("remote_name", name)]
    if not via or host or user:
        required += [("remote_host", host), ("remote_user", user)]
    missing = [k for k, v in required if not v]
    if missing:
        raise ItemError(f"{label}: manca {', '.join(missing)}")
    if not NAME_RE.match(name):
        raise ItemError(f"{label}: remote_name '{name}' contiene caratteri non validi")
    try:
        port = int(port) if port else DEFAULT_PORTS[kind]
    except ValueError:
        raise ItemError(f"{label}: remote_port '{port}' non e un numero")

    aliases = []
    for a in f.get("remote_alias", []):
        alias, _, path = a.partition(":")
        if not NAME_RE.match(alias):
            raise ItemError(f"{label}: remote_alias '{a}' non valido (atteso nome:path)")
        aliases.append((alias, path))
    ssh_aliases = f.get("remote_ssh_alias", [])
    for a in ssh_aliases:
        if not NAME_RE.match(a):
            raise ItemError(f"{label}: remote_ssh_alias '{a}' non valido")
    rclone_opts, ssh_opts = parse_opts(f.get("remote_opt", []), label)

    return Remote(
        item_id=item.get("id", ""),
        item_name=item.get("name", ""),
        revision=item.get("revisionDate", ""),
        kind=kind,
        tls=rtype == "ftps",
        name=name,
        host=host,
        user=user,
        port=port,
        pwd=pwd,
        key=one("remote_key"),
        aliases=aliases,
        ssh_aliases=ssh_aliases,
        rclone_opts=rclone_opts,
        ssh_opts=ssh_opts,
        rtype=rtype,
        old=bool(OLD_RE.search(item.get("name", ""))),
        direct=bool(host),
        via=via,
        path=path,
        sudo=sudo,
    )


def collect(items):
    remotes = []
    for item in items:
        try:
            r = parse_remote(item)
        except ItemError as e:
            warn(f"{e}: saltato")
            continue
        if r is not None:
            remotes.append(r)
    remotes = [r for r in remotes if r.direct] + derive_via(remotes)
    remotes.sort(key=lambda r: (r.name, r.old, r.item_id))
    drop_alias_clashes(remotes, "aliases", "remote_alias", key=lambda a: a[0])
    drop_alias_clashes(remotes, "ssh_aliases", "remote_ssh_alias")
    return remotes


def derive_via(remotes):
    """Per ogni item con remote_via, un remote con i dati di accesso della macchina."""
    machines = {}
    for m in remotes:
        if m.direct and m.kind == "sftp":
            machines.setdefault(m.name, []).append(m)
    for group in machines.values():
        group.sort(key=lambda m: m.revision, reverse=True)
        group.sort(key=lambda m: m.old)
    out = []
    for r in remotes:
        if not r.via:
            continue
        m = (machines.get(r.via) or [None])[0]
        if m is None or m.item_id == r.item_id:
            warn(f"\"{r.item_name}\": remote_via {r.via} non e il remote_name di un item ssh/sftp: saltato")
            continue
        out.append(replace(
            m, item_id=r.item_id, item_name=f"{r.item_name} (via {m.name})", revision=r.revision,
            name=r.name, rtype="via", old=r.old, via=m.name, via_id=m.item_id, path=r.path, sudo=r.sudo,
            aliases=[] if r.direct else r.aliases, ssh_aliases=[] if r.direct else r.ssh_aliases))
    return out


def drop_alias_clashes(remotes, attr, label, key=lambda a: a):
    """Un alias non puo coincidere con un remote_name o con un altro alias: si salta l'alias."""
    names = {r.name for r in remotes}
    seen = {}
    for r in remotes:
        kept = []
        for a in getattr(r, attr):
            n = key(a)
            other = "un remote_name" if n in names else seen.get(n)
            if other:
                warn(f"\"{r.item_name}\": {label} {n} gia usato da {other}: saltato")
                continue
            seen[n] = f"\"{r.item_name}\""
            kept.append(a)
        setattr(r, attr, kept)


def resolve_names(remotes, target):
    """Remote per un file (rclone o ssh) con i remote_name resi unici.

    A parita di nome vince l'item non OLD, poi il tipo piu adatto al file, poi il piu
    recente; gli altri prendono il suffisso .old (item con OLD nel nome) o .<remote_type>.
    """
    rank = PREFERRED[target]
    groups = {}
    for r in remotes:
        if r.rtype in rank:
            groups.setdefault(r.name, []).append(r)
    taken = set(groups)
    for r in remotes:
        if target == "rclone":
            taken.update(a for a, _ in r.aliases)
        else:
            taken.update(r.ssh_aliases)
    out = []
    for name, group in groups.items():
        group.sort(key=lambda r: r.item_id)
        group.sort(key=lambda r: r.revision, reverse=True)
        group.sort(key=lambda r: (r.old, rank.index(r.rtype)))
        out.append(group[0])
        for r in group[1:]:
            if r.old:
                suffix = "old"
            elif r.rtype == "via":
                suffix = "ssh"
            elif any(g.rtype == "via" for g in group):
                suffix = "sftp"
            else:
                suffix = r.rtype
            base = f"{name}.{suffix}"
            new, n = base, 2
            while new in taken:
                new, n = f"{base}-{n}", n + 1
            taken.add(new)
            warn(f"{target}: \"{r.item_name}\" diventa {new} ({name} e di \"{group[0].item_name}\")")
            out.append(replace(r, name=new))
    return sorted(out, key=lambda r: r.name)


# --- rclone ------------------------------------------------------------------

def default_rclone_config():
    return os.environ.get("RCLONE_CONFIG") or os.path.expanduser("~/.config/rclone/rclone.conf")


def split_sections(text):
    """(preambolo, [(nome, righe)]); i commenti subito sopra una sezione restano con lei."""
    lines = text.splitlines()
    heads = [i for i, l in enumerate(lines) if SECTION_RE.match(l)]
    starts, prev = [], 0
    for i in heads:
        start = i
        while start > prev and lines[start - 1].lstrip().startswith(("#", ";")):
            start -= 1
        starts.append(start)
        prev = i + 1
    preamble = lines[:starts[0]] if starts else lines
    sections = []
    for k, i in enumerate(heads):
        end = starts[k + 1] if k + 1 < len(starts) else len(lines)
        sections.append((SECTION_RE.match(lines[i]).group(1), lines[starts[k]:end]))
    return preamble, sections


def managed_info(lines):
    """(item_id, revision) se la sezione e generata da bw-remote, altrimenti None."""
    for line in lines:
        # LEGACY_META_RE: sezioni scritte dalla 0.1, marcate con un commento
        m = DESC_RE.match(line) or LEGACY_META_RE.match(line)
        if m:
            return m.group(1), m.group(2)
    return None


def section_values(lines):
    out = {}
    for line in lines:
        key, eq, value = line.partition("=")
        if eq and not line.lstrip().startswith(("#", ";", "[")):
            out[key.strip()] = value.strip()
    return out


def obscure(pwd):
    res = subprocess.run(["rclone", "obscure", "-"], input=pwd, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"rclone obscure: {res.stderr.strip()}")
    return res.stdout.strip()


def via_remote(machine, r):
    """Destinazione dell'alias via macchina. Con remote_via_sudo rclone passa dal client ssh
    (connessione da ssh config) e lancia sftp-server e gli hash come utente del sito."""
    if not r.sudo:
        return f"{machine}:{r.path}"
    sudo = f"sudo -n -u {r.sudo}"
    opts = {
        "ssh": f"ssh -o BatchMode=yes -o LogLevel=ERROR {r.via}",
        "server_command": f"{sudo} {SFTP_SERVER}",
        "md5sum_command": f"{sudo} md5sum",
        "sha1sum_command": f"{sudo} sha1sum",
        "shell_type": "unix",
    }
    return machine + "".join(f",{k}='{v}'" for k, v in opts.items()) + f":{r.path}"


def render_rclone(remotes, previous, default_key=""):
    """Una lista di righe per ogni sezione; previous: nome -> ((item_id, revision), valori)."""
    chunks = []
    # nome con cui la macchina compare in rclone.conf, per gli alias via macchina
    machine_names = {r.item_id: r.name for r in remotes if r.rtype != "via"}
    for r in remotes:
        desc = f"bw-remote {r.item_id} {r.revision} {' '.join(r.item_name.split())}"
        if r.rtype == "via":
            machine = machine_names.get(r.via_id)
            if machine is None:
                warn(f"rclone: {r.name}: la macchina {r.via} non e in rclone.conf: saltato")
                continue
            kv = {"type": "alias", "description": desc, "remote": via_remote(machine, r)}
        else:
            kv = {"type": r.kind, "description": desc, "host": r.host, "user": r.user, "port": str(r.port)}
            old_meta, old = previous.get(r.name, (None, {}))
            if r.pwd:
                # rclone obscure cambia a ogni chiamata: se l'item non e cambiato teniamo la vecchia
                same = old_meta == (r.item_id, r.revision) and old.get("pass")
                kv["pass"] = old["pass"] if same else obscure(r.pwd)
            # la libreria sftp di rclone non prova le chiavi di default come fa ssh
            key = r.key or (default_key if r.kind == "sftp" and not r.pwd else "")
            if key:
                kv["key_file"] = key
            if r.tls:
                kv["explicit_tls"] = "true"
            kv.update(r.rclone_opts)
            if r.kind == "sftp" and old.get("host") == r.host:
                for k in AUTO_KEYS:
                    if k in old and k not in kv:
                        kv[k] = old[k]
        chunks.append([f"[{r.name}]"] + [f"{k} = {v}" for k, v in kv.items()])
        for alias, path in r.aliases:
            chunks.append([f"[{alias}]", "type = alias", f"description = {desc}", f"remote = {r.name}:{path}"])
    return chunks


def build_rclone(remotes, text, default_key=""):
    """Il file con le sezioni scritte a mano invariate e quelle di bw-remote rigenerate in fondo."""
    preamble, sections = split_sections(text)
    previous, manual = {}, []
    for name, lines in sections:
        info = managed_info(lines)
        if info:
            previous[name] = (info, section_values(lines))
        else:
            manual.append((name, lines))
    taken = {name for name, _ in manual}
    kept = []
    for r in remotes:
        if r.name in taken:
            warn(f"rclone: [{r.name}] gia definito a mano in rclone.conf: saltato")
            continue
        aliases = []
        for alias, path in r.aliases:
            if alias in taken:
                warn(f"rclone: alias [{alias}] gia definito a mano in rclone.conf: saltato")
            else:
                aliases.append((alias, path))
        kept.append(replace(r, aliases=aliases))

    out = [l for l in preamble if not LEGACY_LINE_RE.match(l)]
    for _, lines in manual:
        out += [l for l in lines if not LEGACY_LINE_RE.match(l)]
    while out and not out[-1].strip():
        out.pop()
    chunks = render_rclone(kept, previous, default_key)
    for chunk in chunks:
        out += ([""] if out else []) + chunk
    if not out:
        return ""
    # come rclone quando riscrive il file: riga vuota anche dopo l'ultima sezione
    return "\n".join(out) + ("\n\n" if chunks else "\n")


# --- ssh ---------------------------------------------------------------------

def ssh_hosts(text):
    hosts = set()
    for m in re.finditer(r"^\s*Host\s+(.+)$", text, re.M | re.I):
        hosts.update(m.group(1).split())
    return hosts


def render_ssh(remotes, taken):
    lines = [HEADER]
    for r in remotes:
        if r.kind != "sftp":
            continue
        names = []
        for n in r.ssh_names:
            if n in taken:
                warn(f"ssh: Host {n} gia definito in ssh config: saltato")
            else:
                names.append(n)
        if not names:
            continue
        opts = {"HostName": r.host, "User": r.user, "Port": str(r.port)}
        if r.key:
            opts["IdentityFile"] = r.key
        opts.update(r.ssh_opts)
        lines += ["", r.meta, "Host " + " ".join(names)] + [f"  {k} {v}" for k, v in opts.items()]
    return "\n".join(lines) + "\n"


def include_line(path):
    home = os.path.expanduser("~")
    shown = "~" + path[len(home):] if path.startswith(home + os.sep) else path
    return f"Include {shown}"


def ensure_include(text, path):
    line = include_line(path)
    pattern = re.compile(r"^\s*Include\s+(\S+)\s*$", re.M | re.I)
    for m in pattern.finditer(text):
        if os.path.expanduser(m.group(1)) == path:
            return text
    # in testa: un Include dopo un Host varrebbe solo per quell'Host
    return f"{line}\n\n{text}" if text else f"{line}\n"


# --- scrittura ---------------------------------------------------------------

def read(path):
    try:
        with open(path) as fh:
            return fh.read()
    except FileNotFoundError:
        return ""


def mask(line):
    return re.sub(r"^([-+ ]pass = ).*$", r"\1***", line)


def show_diff(path, old, new):
    diff = list(difflib.unified_diff(old.splitlines(), new.splitlines(), path, path, lineterm=""))
    for line in diff:
        print(mask(line))
    return bool(diff)


def write(path, text):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    if os.path.exists(path):
        stamp = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
        shutil.copy2(path, f"{path}.bak-{stamp}")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".bw-remote-")
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def cmd_sync(args):
    remotes = collect(load_items(args))
    rclone_path = os.path.expanduser(args.rclone_config)
    ssh_path = os.path.expanduser(args.ssh_config)
    include_path = os.path.expanduser(args.ssh_include)

    rclone_old = read(rclone_path)
    ssh_old = read(ssh_path)
    include_old = read(include_path)
    targets = [
        (rclone_path, rclone_old, build_rclone(resolve_names(remotes, "rclone"), rclone_old, args.key)),
        (include_path, include_old, render_ssh(resolve_names(remotes, "ssh"), ssh_hosts(ssh_old))),
        (ssh_path, ssh_old, ensure_include(ssh_old, include_path)),
    ]

    changed = [(p, old, new) for p, old, new in targets if show_diff(p, old, new)]
    n_ssh = sum(1 for r in remotes if r.kind == "sftp")
    print(f"{len(remotes)} remote da Bitwarden ({n_ssh} ssh/sftp, {len(remotes) - n_ssh} ftp)")
    if not changed:
        print("nessuna modifica")
    elif not args.apply:
        print("dry-run: rilancia con --apply per scrivere")
    else:
        for p, _, new in changed:
            write(p, new)
            print(f"scritto {p}")


# --- copy-key ----------------------------------------------------------------

ASKPASS = '#!/bin/sh\nprintf "%s\\n" "$BW_REMOTE_PASS"\n'


def ssh_base(r):
    base = ["-p", str(r.port), "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=accept-new"]
    for k, v in r.ssh_opts.items():
        base += ["-o", f"{k}={v}"]
    return base


def key_works(r, key):
    opts = ["-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-i", key]
    target = f"{r.user}@{r.host}"
    base = ssh_base(r)
    # sftp prima: copre anche gli utenti chroot senza shell
    sftp_base = ["-P" if a == "-p" else a for a in base]
    res = subprocess.run(["sftp", "-q", "-b", "-"] + opts + sftp_base + [target],
                         input="bye\n", capture_output=True, text=True, timeout=60)
    if res.returncode == 0:
        return True
    res = subprocess.run(["ssh"] + opts + base + [target, "true"],
                         stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    return res.returncode == 0


def copy_id(r, pub, askpass):
    env = dict(os.environ, SSH_ASKPASS=askpass, SSH_ASKPASS_REQUIRE="force",
               BW_REMOTE_PASS=r.pwd, DISPLAY=os.environ.get("DISPLAY", ":0"))
    cmd = ["ssh-copy-id", "-f", "-i", pub, "-o", "PubkeyAuthentication=no"] + ssh_base(r)
    last = ""
    for extra in ([], ["-s"]):
        res = subprocess.run(cmd[:1] + extra + cmd[1:] + [f"{r.user}@{r.host}"], env=env,
                             stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        if res.returncode == 0:
            return ""
        lines = [l for l in (res.stderr + res.stdout).splitlines() if l.strip()]
        last = lines[-1] if lines else f"exit {res.returncode}"
    return last


def cmd_copy_key(args):
    # gli accessi via macchina usano l'utente della macchina: la chiave va copiata una volta sola
    remotes = [r for r in resolve_names(collect(load_items(args)), "ssh") if r.rtype != "via"]
    if args.names:
        remotes = [r for r in remotes
                   if any(fnmatch.fnmatch(n, p) for n in r.ssh_names for p in args.names)]
    if not remotes:
        die("nessun remote ssh/sftp corrispondente")

    tmpdir = tempfile.mkdtemp(prefix="bw-remote-")
    askpass = os.path.join(tmpdir, "askpass")
    with open(askpass, "w") as fh:
        fh.write(ASKPASS)
    os.chmod(askpass, 0o700)

    failed = 0
    try:
        for r in remotes:
            key = os.path.expanduser(r.key or args.key)
            pub = key + ".pub"
            label = f"{r.name} ({r.user}@{r.host}:{r.port})"
            if not os.path.exists(pub):
                print(f"KO   {label}: {pub} non trovata")
                failed += 1
                continue
            try:
                if key_works(r, key):
                    print(f"ok   {label}: la chiave funziona gia")
                    continue
                if not r.pwd:
                    print(f"KO   {label}: chiave non accettata e remote_pwd mancante")
                    failed += 1
                    continue
                if not args.apply:
                    print(f"da fare {label}: aggiungerei {pub}")
                    continue
                err = copy_id(r, pub, askpass)
                if err:
                    print(f"KO   {label}: {err}")
                    failed += 1
                elif key_works(r, key):
                    print(f"+    {label}: chiave aggiunta")
                else:
                    print(f"KO   {label}: copiata ma il login con la chiave non funziona")
                    failed += 1
            except subprocess.TimeoutExpired:
                print(f"KO   {label}: timeout")
                failed += 1
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    if not args.apply:
        print("dry-run: rilancia con --apply per copiare le chiavi")
    sys.exit(1 if failed else 0)


def main(argv=None):
    p = argparse.ArgumentParser(prog="bw-remote", description=__doc__)
    p.add_argument("--version", action="version", version=f"bw-remote {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--apply", action="store_true", help="scrive davvero (default: dry-run)")
    common.add_argument("--no-sync", action="store_true", help="non esegue bw sync")
    common.add_argument("--input", metavar="FILE", help="legge gli item da un JSON di bw list items invece che da bw")
    common.add_argument("--key", default=DEFAULT_KEY,
                        help=f"chiave privata per gli item senza remote_key (default {DEFAULT_KEY})")

    s = sub.add_parser("sync", parents=[common], help="aggiorna rclone.conf e ssh config")
    s.add_argument("--rclone-config", default=default_rclone_config())
    s.add_argument("--ssh-config", default="~/.ssh/config")
    s.add_argument("--ssh-include", default="~/.ssh/config.d/bw-remote")
    s.set_defaults(func=cmd_sync)

    c = sub.add_parser("copy-key", parents=[common], help="installa la chiave pubblica sugli host ssh/sftp usando la password")
    c.add_argument("names", nargs="*", help="remote_name o alias ssh (glob), default tutti")
    c.set_defaults(func=cmd_copy_key)

    args = p.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
